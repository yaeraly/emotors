{
  "name": "@emotors/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "node prisma/scripts/pre-migrate-clean.js && prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node prisma/scripts/pre-migrate-clean.js && prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node prisma/scripts/pre-migrate-clean.js && prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:cleanup": "ts-node prisma/scripts/dev-database-cleanup.ts",
    "db:cleanup:preview": "ts-node prisma/scripts/dev-database-cleanup.ts --preview",
    "db:cleanup:verify": "ts-node prisma/scripts/dev-database-cleanup.ts --verify",
    "db:cleanup:scan": "ts-node prisma/scripts/dev-database-cleanup-scan.ts",
    "product-code:migrate:preview": "ts-node prisma/scripts/product-code-migration.ts preview",
    "product-code:migrate:apply": "ts-node prisma/scripts/product-code-migration.ts apply",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:receiving": "node --import tsx --test src/distribution/branch-receiving.integration.test.ts",
    "audit:hq-fifo": "tsx scripts/audit-hq-fifo-inventory.ts",
    "repair:hq-fifo-from-receipts": "tsx scripts/repair-hq-fifo-from-receipts.ts",
    "verify:product-catalog-costs": "tsx scripts/verify-product-catalog-cost-table.ts",
    "repair:product-catalog-reference-costs": "tsx scripts/repair-product-catalog-reference-costs.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-fastify": "latest",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "passport": "latest",
    "passport-jwt": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@types/node": "latest",
    "@types/passport-jwt": "latest",
    "prisma": "^6.19.3",
    "ts-node": "latest",
    "tsx": "latest",
    "typescript": "5.8.3"
  }
}
