{
  "name": "@emotors/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "product-code:migrate:preview": "ts-node prisma/scripts/product-code-migration.ts preview",
    "product-code:migrate:apply": "ts-node prisma/scripts/product-code-migration.ts apply"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-fastify": "latest",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "passport": "latest",
    "passport-jwt": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@types/node": "latest",
    "@types/passport-jwt": "latest",
    "prisma": "^6.19.3",
    "ts-node": "latest",
    "typescript": "5.8.3"
  }
}
