  factory                               Factory?                               @relation(fields: [factoryId], references: [id])
  hqWarehouseId                         String
  hqWarehouse                           Warehouse                              @relation(fields: [hqWarehouseId], references: [id])
  status                                ProcurementOrderStatus                 @default(DRAFT)
  currency                              String                                 @default("CNY")
  defaultYuanRate                       Decimal                                @default(0) @db.Decimal(14, 4)
  defaultUsdRate                        Decimal                                @default(0) @db.Decimal(14, 4)
  cargoRateUsdPerKg                     Decimal                                @default(0) @db.Decimal(14, 4)
  cargoTotalWeightKg                    Decimal                                @default(0) @db.Decimal(14, 3)
  cargoCompany                          String?
  cargoReceiptNumber                    String?
  cargoReceiptDate                      DateTime?
  cargoReceiptNote                      String?
  totalCargoCostUsd                     Decimal                                @default(0) @db.Decimal(14, 2)
  totalCargoCostKgs                     Decimal                                @default(0) @db.Decimal(14, 2)
  totalNetWeightKg                      Decimal                                @default(0) @db.Decimal(14, 3)
  totalPackagingWeightKg                Decimal                                @default(0) @db.Decimal(14, 3)
  purchaseDate                          DateTime?
  totalYuan                             Decimal                                @default(0) @db.Decimal(14, 2)
  totalPaidYuan                         Decimal                                @default(0) @db.Decimal(18, 8)
  totalPaidKgs                          Decimal                                @default(0) @db.Decimal(14, 2)
  remainingYuan                         Decimal                                @default(0) @db.Decimal(18, 8)
  weightedAverageYuanRate               Decimal?                               @db.Decimal(14, 4)
  supplierPaymentStatus                 ProcurementSupplierPaymentLedgerStatus @default(UNPAID)
  totalTransportCostKgs                 Decimal                                @default(0) @db.Decimal(14, 2)
  totalCostKgs                          Decimal                                @default(0) @db.Decimal(14, 2)
  totalWeightKg                         Decimal                                @default(0) @db.Decimal(14, 3)
  costPerKg                             Decimal                                @default(0) @db.Decimal(14, 4)
  chinaDomesticTransportYuan            Decimal                                @default(0) @db.Decimal(14, 2)
  chinaDomesticTransportKgs             Decimal                                @default(0) @db.Decimal(14, 2)
  chinaDomesticTransportCompanyId       String?
  chinaDomesticTransportCompany         TransportCompany?                      @relation("ChinaDomesticTransportCompany", fields: [chinaDomesticTransportCompanyId], references: [id])
  chinaExportTransportKgs               Decimal                                @default(0) @db.Decimal(14, 2)
  chinaExportTransportCompanyId         String?
  chinaExportTransportCompany           TransportCompany?                      @relation("ChinaExportTransportCompany", fields: [chinaExportTransportCompanyId], references: [id])
  localTransportKgs                     Decimal                                @default(0) @db.Decimal(14, 2)
  svhToHqTransportCompanyId             String?
  svhToHqTransportCompany               TransportCompany?                      @relation("SvhToHqTransportCompany", fields: [svhToHqTransportCompanyId], references: [id])
  packagingCostKgs                      Decimal                                @default(0) @db.Decimal(14, 2)
  customsCostKgs                        Decimal                                @default(0) @db.Decimal(14, 2)
  insuranceCostKgs                      Decimal                                @default(0) @db.Decimal(14, 2)
  bankFeeCostKgs                        Decimal                                @default(0) @db.Decimal(14, 2)
  otherExpenseKgs                       Decimal                                @default(0) @db.Decimal(14, 2)
  landedCostStatus                      ProcurementLandedCostStatus            @default(PENDING_WEIGHT)
  costConfirmationStatus                ProcurementCostConfirmationStatus      @default(PRELIMINARY)
  estimatedSupplierCostKgs              Decimal                                @default(0) @db.Decimal(14, 2)
  landedCostCalculationVersion          Int                                    @default(0)
  landedCostCalculatedAt                DateTime?
  estimatedArrivalDate                  DateTime?
  actualArrivalDate                     DateTime?
  createdById                           String
  createdBy                             User                                   @relation("ProcurementOrderCreator", fields: [createdById], references: [id])
  approvedById                          String?
  approvedBy                            User?                                  @relation("ProcurementOrderApprover", fields: [approvedById], references: [id])
  approvedAt                            DateTime?
  paidAt                                DateTime?
  shippedAt                             DateTime?
  arrivedAt                             DateTime?
  receivedToHqAt                        DateTime?
  hqStockMovementCreatedAt              DateTime?
  sentToSupplierAt                      DateTime?
  editableUntil                         DateTime?
  unlockedById                          String?
  unlockedBy                            User?                                  @relation("ProcurementOrderUnlocker", fields: [unlockedById], references: [id])
  unlockedAt                            DateTime?
  unlockExpiresAt                       DateTime?
  unlockReason                          String?
  chinaDomesticTransportUnlockedAt      DateTime?
  chinaDomesticTransportUnlockExpiresAt DateTime?
  chinaDomesticTransportUnlockReason    String?
  chinaDomesticTransportUnlockedById    String?
  chinaDomesticTransportUnlockedBy      User?                                  @relation("ProcurementChinaDomesticTransportUnlocker", fields: [chinaDomesticTransportUnlockedById], references: [id])
  note                                  String?
  supplierInvoiceNumber                 String?
  expectedPaymentDate                   DateTime?
  /** Comment stored when HQ Accountant postpones supplier payment (no ledger impact). */
  paymentPostponeComment                String?
  /** CNY amount SM requests HQ Accountant to pay (may match order total or invoice). */
  requestedPaymentYuan                  Decimal?                               @db.Decimal(14, 2)
  invoiceSentToAccountantAt             DateTime?
  invoiceSentById                       String?
  invoiceSentBy                         User?                                  @relation("ProcurementInvoiceSender", fields: [invoiceSentById], references: [id])
  /** Accountant review of the supplier invoice request (not payment tranche status). */
  invoiceReviewStatus                   String?
  invoiceReturnReason                   String?
  invoiceRejectReason                   String?
  invoiceReviewedAt                     DateTime?
  invoiceReviewedById                   String?
  items                                 ProcurementOrderItem[]
  receivings                            ProcurementGoodsReceiving[]
  differenceReports                     ProcurementDifferenceReport[]
  purchasePriceHistory                  ProductPurchasePriceHistory[]
  supplierPayments                      ProcurementSupplierPayment[]
  paymentInfoVersions                   ProcurementPaymentInfoVersion[]
  transportExpenses                     ProcurementTransportExpense[]
  costAdjustments                       ProcurementCostAdjustment[]
  svhToHqTransport                      ProcurementSvhToHqTransport?
  chinaReceivingDraftRows               ChinaReceivingDraftRow[]
  chinaReceivingEditSession             ChinaReceivingEditSession?
  landedCostSnapshots                   ProcurementLandedCostSnapshot[]
  supplyInquiries                       SupplyInquiry[]
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
  deletedAt                             DateTime?

  @@index([supplierId])
  @@index([factoryId])
  @@index([hqWarehouseId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([unlockedById])
  @@index([chinaDomesticTransportCompanyId])
  @@index([chinaExportTransportCompanyId])
  @@index([svhToHqTransportCompanyId])
  @@index([invoiceSentById])
  @@index([invoiceSentToAccountantAt])
  @@index([invoiceReviewStatus])
  @@index([supplierPaymentStatus])
  @@index([costConfirmationStatus])
}

