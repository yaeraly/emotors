model ProcurementPaymentInfoVersion {
  id                 String                       @id @default(cuid())
  procurementOrderId String
  procurementOrder   ProcurementOrder             @relation(fields: [procurementOrderId], references: [id], onDelete: Cascade)
  versionNumber      Int
  paymentMethod      ProcurementPaymentInfoMethod @default(BANK_ACCOUNT)
  bankName           String?
  accountHolder      String?
  accountNumber      String?
  swiftCode          String?
  bankAddress        String?
  comment            String?
  reason             String?
  isActive           Boolean                      @default(true)
  createdById        String
  createdBy          User                         @relation("ProcurementPaymentInfoCreator", fields: [createdById], references: [id])
  supplierPayments   ProcurementSupplierPayment[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  // Short mapped name: the default Prisma name exceeds PostgreSQL's 63-char
  // identifier limit and truncates to "...versionNumber_", which breaks migrate dev.
  @@unique([procurementOrderId, versionNumber], map: "ProcurementPaymentInfoVersion_order_ver_key")
  @@index([procurementOrderId])
  @@index([isActive])
  @@index([createdById])
}

model ProcurementSupplierPayment {
  id                         String                           @id @default(cuid())
  procurementOrderId         String
  procurementOrder           ProcurementOrder                 @relation(fields: [procurementOrderId], references: [id], onDelete: Cascade)
  supplierId                 String
  supplier                   Supplier                         @relation(fields: [supplierId], references: [id])
  paymentInfoVersionId       String?
  paymentInfoVersion         ProcurementPaymentInfoVersion?   @relation(fields: [paymentInfoVersionId], references: [id])
  sequenceNumber             Int                              @default(1)
  paymentDate                DateTime
  amountYuan                 Decimal                          @db.Decimal(18, 8)
  exchangeRate               Decimal                          @db.Decimal(14, 4)
  calculatedAmountKgs        Decimal                          @default(0) @db.Decimal(14, 2)
  approvedAmountKgs          Decimal                          @default(0) @db.Decimal(14, 2)
  actualPaidKgs              Decimal?                         @db.Decimal(14, 2)
  amountKgs                  Decimal                          @db.Decimal(14, 2)
  kgsAdjustmentReason        ProcurementKgsAdjustmentReason?
  kgsAdjustmentComment       String?
  kgsAdjustedById            String?
  kgsAdjustedBy              User?                            @relation("ProcurementSupplierPaymentKgsAdjuster", fields: [kgsAdjustedById], references: [id])
  kgsAdjustedAt              DateTime?
  paymentMethod              ProcurementSupplierPaymentMethod
  recipientName              String?
  recipientCompany           String?
  bankName                   String?
  beneficiaryName            String?
  accountNumber              String?
  swiftCode                  String?
  cardholderName             String?
  cardNumberMasked           String?
  paymentInstructions        String?
  paymentDeadline            DateTime?
  intendedFinanceAccountId   String?
  intendedFinanceAccount     FinanceAccount?                  @relation("ProcurementPaymentIntendedAccount", fields: [intendedFinanceAccountId], references: [id])
  actualFinanceAccountId     String?
  actualFinanceAccount       FinanceAccount?                  @relation("ProcurementPaymentActualAccount", fields: [actualFinanceAccountId], references: [id])
  accountChangeReason        String?
  receiptNumber              String?
  transactionNumber          String?
  notes                      String?
  accountantComment          String?
  cashierComment             String?
  returnReason               String?
  actualPaidDifferenceReason String?
  status                     ProcurementSupplierPaymentStatus @default(DRAFT)
  version                    Int                              @default(1)
  idempotencyKey             String?                          @unique
  sentToCashierAt            DateTime?
  paidAt                     DateTime?
  returnedAt                 DateTime?
  returnedById               String?
  returnedBy                 User?                            @relation("ProcurementSupplierPaymentReturner", fields: [returnedById], references: [id])
  accountantId               String?
  accountant                 User?                            @relation("ProcurementSupplierPaymentAccountant", fields: [accountantId], references: [id])
  cashierId                  String?
  cashier                    User?                            @relation("ProcurementSupplierPaymentCashier", fields: [cashierId], references: [id])
  /** Cashier execution lifecycle for accountant-prepared payment tasks. */
  executionStatus            String?
  executionStartedAt         DateTime?
  failureReason              String?
  ledgerEntryId              String?                          @unique
  ledgerEntry                FinanceLedgerEntry?              @relation("ProcurementSupplierPaymentLedgerEntry", fields: [ledgerEntryId], references: [id])
  reversalOfPaymentId        String?
  reversalOfPayment          ProcurementSupplierPayment?      @relation("ProcurementPaymentReversal", fields: [reversalOfPaymentId], references: [id])
  reversals                  ProcurementSupplierPayment[]     @relation("ProcurementPaymentReversal")
  voidedAt                   DateTime?
  voidedById                 String?
  voidedBy                   User?                            @relation("ProcurementSupplierPaymentVoider", fields: [voidedById], references: [id])
  voidReason                 String?
  createdById                String
  createdBy                  User                             @relation("ProcurementSupplierPaymentCreator", fields: [createdById], references: [id])
  attachments                FileAttachment[]
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt

  @@unique([procurementOrderId, sequenceNumber])
  @@index([procurementOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([paymentDate])
  @@index([accountantId])
  @@index([cashierId])
  @@index([intendedFinanceAccountId])
  @@index([actualFinanceAccountId])
  @@index([sentToCashierAt])
  @@index([paymentInfoVersionId])
  @@index([executionStatus])
