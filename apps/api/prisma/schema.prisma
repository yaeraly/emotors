model RbacRole {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  action          String
  description     String?
  roles           RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         RbacRole   @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  roleId       String
  role         RbacRole @relation(fields: [roleId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("UserRoleAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserPermissionHolder", fields: [userId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedById  String?
  grantedBy    User?      @relation("UserPermissionGranter", fields: [grantedById], references: [id])
  revokedById  String?
  revokedBy    User?      @relation("UserPermissionRevoker", fields: [revokedById], references: [id])
  isActive     Boolean    @default(true)
  grantedAt    DateTime   @default(now())
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([isActive])
}

model LoginHistory {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  ipAddress String?
  device    String?
  browser   String?
  success   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([loginAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

model Customer {
  id                   String                @id @default(cuid())
  fullName             String
  phone                String
  whatsappPhone        String?
  additionalPhone      String?
  branchId             String
  branch               Branch                @relation(fields: [branchId], references: [id])
  customerType         CustomerType            @default(RETAIL)
  loyaltyCategory      CustomerLoyaltyCategory @default(STANDARD)
  companyName          String?
  taxId                String?
  region               String?
  address              String?
  contactPerson        String?
  creditLimit          Decimal?                @db.Decimal(14, 2)
  convertedToBranchId  String?                 @unique
  convertedToBranch    Branch?                 @relation("CustomerFranchiseConversion", fields: [convertedToBranchId], references: [id])
  status               CustomerStatus          @default(NEW)
  notes                String?
  totalPurchaseAmount  Decimal               @default(0) @db.Decimal(14, 2)
  purchaseVolume       Decimal               @default(0) @db.Decimal(14, 2)
  totalProfitAmount    Decimal               @default(0) @db.Decimal(14, 2)
  totalDebtAmount      Decimal               @default(0) @db.Decimal(14, 2)
  lastPurchaseAt       DateTime?
  events               CustomerEvent[]
  followUps            FollowUp[]
  sales                Sale[]
  payments             Payment[]
  installments         InstallmentSchedule[]
  serviceOrders        ServiceOrder[]
  serviceOrderPayments ServiceOrderPayment[]
  warranties           Warranty[]
  hqB2bSales           HqB2bSale[]
  priceLists           CustomerPriceList[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, customerType])
  @@index([customerType])
  @@index([loyaltyCategory])
  @@index([fullName])
  @@index([phone])
  @@index([whatsappPhone])
}

/// Historical snapshot of a customer-facing price list generated for WhatsApp/PDF sharing.
model CustomerPriceList {
  id                     String                         @id @default(cuid())
  customerId             String
  customer               Customer                       @relation(fields: [customerId], references: [id])
  branchId               String
  branch                 Branch                         @relation(fields: [branchId], references: [id])
  customerType           CustomerType
  loyaltyCategory        CustomerLoyaltyCategory        @default(STANDARD)
  loyaltyDiscountPercent Decimal                        @default(0) @db.Decimal(8, 2)
  pricingPolicyVersionId String?
  pricingPolicyVersion   PricingPolicyVersion?          @relation(fields: [pricingPolicyVersionId], references: [id])
  title                  String
  productCount           Int                            @default(0)
  currency               String                         @default("KGS")
  fileName               String?
  filePath               String?
  fileUrl                String?
  shareChannel           CustomerPriceListShareChannel?
  shareStatus            CustomerPriceListShareStatus   @default(GENERATED)
  sharedAt               DateTime?
  snapshotJson           Json
  generatedById          String
  generatedBy            User                           @relation("CustomerPriceListGenerator", fields: [generatedById], references: [id])
  generatedAt            DateTime                       @default(now())
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([generatedById])
  @@index([generatedAt])
  @@index([pricingPolicyVersionId])
  @@index([shareStatus])
}

model CustomerEvent {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  type        CustomerEventType
  message     String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
}

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpStatus @default(OPEN)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Sale {
  id                     String                   @id @default(cuid())
  branchId               String
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  customerId             String
  customer               Customer                 @relation(fields: [customerId], references: [id])
  sellerId               String
  seller                 User                     @relation("SaleSeller", fields: [sellerId], references: [id])
  pricingPolicyVersionId String?
  pricingPolicyVersion   PricingPolicyVersion?    @relation(fields: [pricingPolicyVersionId], references: [id])
  receiptNumber          String                   @unique
  saleDate               DateTime                 @default(now())
  totalAmount            Decimal                  @default(0) @db.Decimal(14, 2)
  totalCost              Decimal                  @default(0) @db.Decimal(14, 2)
  profitAmount           Decimal                  @default(0) @db.Decimal(14, 2)
  paidAmount             Decimal                  @default(0) @db.Decimal(14, 2)
  debtAmount             Decimal                  @default(0) @db.Decimal(14, 2)
  paymentStatus          PaymentStatus            @default(DEBT)
  paymentType            SalePaymentType?
  expectedPaymentAmount  Decimal?                 @db.Decimal(14, 2)
  receivedAmountEnteredBySales Decimal?           @db.Decimal(14, 2)
  expectedChangeAmount   Decimal?                 @db.Decimal(14, 2)
  sentToCashierAt        DateTime?
  sentToCashierById      String?
  sentToCashierBy        User?                    @relation("SaleCashierSender", fields: [sentToCashierById], references: [id])
  status                 SaleStatus               @default(DRAFT)
  draftReceiptText       String?
  whatsappMessageText    String?
  sentToCustomerAt       DateTime?
  approvedAt             DateTime?
  finalizedAt            DateTime?
  cancelledAt            DateTime?
  notes                  String?
  items                  SaleItem[]
  payments               Payment[]
  installments           InstallmentSchedule[]
  installmentApproval    SaleInstallmentApproval?
  receipt                Receipt?
  branchInvoice          BranchInvoice?
  salesCommissions       SalesCommission[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?

  @@index([branchId])
  @@index([customerId])
  @@index([sellerId])
  @@index([paymentStatus])
  @@index([status])
  @@index([sentToCashierAt])
  @@index([sentToCashierById])
  @@index([saleDate])
  @@index([receiptNumber])
}

model SaleItem {
  id                              String                           @id @default(cuid())
  saleId                          String
  sale                            Sale                             @relation(fields: [saleId], references: [id])
  productName                     String
  productId                       String?
  product                         Product?                         @relation(fields: [productId], references: [id])
  productSku                      String?
  quantity                        Int
  unitPrice                       Decimal                          @db.Decimal(14, 2)
  unitCost                        Decimal                          @db.Decimal(14, 2)
  totalPrice                      Decimal                          @db.Decimal(14, 2)
  totalCost                       Decimal                          @db.Decimal(14, 2)
  profitAmount                    Decimal                          @db.Decimal(14, 2)
  pricingPolicyVersionId          String?
  pricingProfileId                String?
  resolvedPriceKgs                Decimal?                         @db.Decimal(14, 2)
  minimumPriceSnapshot            Decimal?                         @db.Decimal(14, 2)
  recommendedPriceSnapshot        Decimal?                         @db.Decimal(14, 2)
  maximumPriceSnapshot            Decimal?                         @db.Decimal(14, 2)
  customerTypeSnapshot            CustomerType?
  customerCategorySnapshot        CustomerLoyaltyCategory?
  priceChangedManually            Boolean                          @default(false)
  priceChangedBy                  String?
  priceChangedAt                  DateTime?
  baseCostKgs                     Decimal?                         @db.Decimal(14, 2)
  baseBranchPriceKgs              Decimal?                         @db.Decimal(14, 2)
  appliedRuleType                 PricingAppliedRuleType?
  appliedRuleId                   String?
  appliedAdjustmentMode           PricingAdjustmentMode?
  appliedAdjustmentValue          Decimal?                         @db.Decimal(14, 2)
  priceResolvedAt                 DateTime?
  priceAboveRecommendedReasonCode PriceAboveRecommendedReasonCode?
  priceAboveRecommendedComment    String?
  createdAt                       DateTime                         @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([pricingPolicyVersionId])
}

enum HqB2bSaleStatus {
  DRAFT
  AWAITING_PAYMENT_CONFIRMATION
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  AWAITING_CEO_APPROVAL
  CEO_REJECTED
  SENT_TO_WAREHOUSE
  RESERVED
  PICKING
  PACKED
  READY_FOR_SHIPMENT
  SHIPPED
  COMPLETED
  CANCELLED
}

enum HqB2bPaymentType {
  FULL_PAYMENT
  INSTALLMENT
}

enum HqB2bPaymentRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  CORRECTION_REQUESTED
}

enum HqB2bInstallmentStatus {
  AWAITING_CEO_APPROVAL
  CEO_APPROVED
  CEO_REJECTED
  AWAITING_DOWN_PAYMENT_CONFIRMATION
  DOWN_PAYMENT_CONFIRMED
  ACTIVE
  OVERDUE
  PAID
  CANCELLED
}

model HqB2bSale {
  id                     String                @id @default(cuid())
  saleNumber             String                @unique
  hqBranchId             String
  hqBranch               Branch                @relation(fields: [hqBranchId], references: [id])
  customerId             String
  customer               Customer              @relation(fields: [customerId], references: [id])
  customerType           CustomerType
  customerNameSnapshot   String
  customerPhoneSnapshot  String?
  customerCompanySnapshot String?
  paymentType            HqB2bPaymentType
  status                 HqB2bSaleStatus       @default(DRAFT)
  totalAmount            Decimal               @db.Decimal(14, 2)
  pricingPolicyVersionId String?
  pricingPolicyVersion   PricingPolicyVersion? @relation(fields: [pricingPolicyVersionId], references: [id])
  createdById            String
  createdBy              User                  @relation("HqB2bSaleCreator", fields: [createdById], references: [id])
  responsibleUserId      String
  responsibleUser        User                  @relation("HqB2bSaleResponsible", fields: [responsibleUserId], references: [id])
  notes                  String?
  submittedAt            DateTime?
  sentToWarehouseAt      DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  items                  HqB2bSaleItem[]
  paymentRequests        HqB2bPaymentRequest[]
  installment            HqB2bInstallmentAgreement?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([hqBranchId])
  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([responsibleUserId])
  @@index([createdAt])
}

model HqB2bSaleItem {
  id                     String                  @id @default(cuid())
  saleId                 String
  sale                   HqB2bSale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId              String
  product                Product                 @relation(fields: [productId], references: [id])
  productNameSnapshot    String
  skuSnapshot            String
  categoryNameSnapshot   String?
  quantity               Int
  unitPrice              Decimal                 @db.Decimal(14, 2)
  lineTotal              Decimal                 @db.Decimal(14, 2)
  costPriceSnapshot      Decimal?                @db.Decimal(14, 2)
  basePriceSnapshot      Decimal?                @db.Decimal(14, 2)
  pricingPolicyVersionId String?
  pricingProfileId       String?
  pricingSource          String?
  appliedRuleType        PricingAppliedRuleType?
  appliedRuleId          String?
  priceResolvedAt        DateTime?
  createdAt              DateTime                @default(now())

  @@index([saleId])
  @@index([productId])
}

model HqB2bPaymentRequest {
  id                   String                    @id @default(cuid())
  saleId               String
  sale                 HqB2bSale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status               HqB2bPaymentRequestStatus @default(PENDING)
  expectedAmount       Decimal                   @db.Decimal(14, 2)
  receivedAmount       Decimal?                  @db.Decimal(14, 2)
  paymentMethod        PaymentMethod?
  financeAccountId     String?
  financeAccount       FinanceAccount?           @relation(fields: [financeAccountId], references: [id])
  transactionReference String?
  receiptDocumentUrl   String?
  paymentDate          DateTime?
  comment              String?
  rejectionReason      String?
  submittedById        String
  submittedBy          User                      @relation("HqB2bPaymentSubmittedBy", fields: [submittedById], references: [id])
  confirmedById        String?
  confirmedBy          User?                     @relation("HqB2bPaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([saleId])
  @@index([status])
}

model HqB2bInstallmentAgreement {
  id                   String                @id @default(cuid())
  saleId               String                @unique
  sale                 HqB2bSale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status               HqB2bInstallmentStatus @default(AWAITING_CEO_APPROVAL)
  saleTotal            Decimal               @db.Decimal(14, 2)
  downPayment          Decimal               @db.Decimal(14, 2)
  remainingBalance     Decimal               @db.Decimal(14, 2)
  paidAmount           Decimal               @default(0) @db.Decimal(14, 2)
  installmentStartDate DateTime
  paymentFrequency     String
  numberOfPayments     Int
  scheduleJson         Json
  nextPaymentDate      DateTime?
  overdueAmount        Decimal               @default(0) @db.Decimal(14, 2)
  ceoApprovedById      String?
  ceoApprovedBy        User?                 @relation("HqB2bInstallmentCeoApprovedBy", fields: [ceoApprovedById], references: [id])
  ceoApprovedAt        DateTime?
  ceoRejectedById      String?
  ceoRejectedBy        User?                 @relation("HqB2bInstallmentCeoRejectedBy", fields: [ceoRejectedById], references: [id])
  ceoRejectedAt        DateTime?
  ceoRejectionReason   String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Payment {
  id               String              @id @default(cuid())
  branchId         String
  branch           Branch              @relation(fields: [branchId], references: [id])
  saleId           String
  sale             Sale                @relation(fields: [saleId], references: [id])
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  amount           Decimal             @db.Decimal(14, 2)
  method           PaymentMethod
  cashReceived     Decimal?            @db.Decimal(14, 2)
  changeAmount     Decimal?            @db.Decimal(14, 2)
  paidAt           DateTime            @default(now())
  note             String?
  status           PaymentRecordStatus @default(ACTIVE)
  financeAccountId String?
  financeAccount   FinanceAccount?     @relation(fields: [financeAccountId], references: [id])
  selfProcessed    Boolean             @default(false)
  voidedAt         DateTime?
  createdById      String
  createdBy        User                @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([createdById])
  @@index([paidAt])
  @@index([method])
  @@index([status])
  @@index([financeAccountId])
}

model InstallmentSchedule {
  id         String            @id @default(cuid())
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  saleId     String
  sale       Sale              @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  paidAmount Decimal           @default(0) @db.Decimal(14, 2)
  status     InstallmentStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model SaleInstallmentApproval {
  id                    String                        @id @default(cuid())
  saleId                String                        @unique
  sale                  Sale                          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  branchId              String
  branch                Branch                        @relation(fields: [branchId], references: [id])
  requestNumber         String                        @unique
  status                SaleInstallmentApprovalStatus @default(DRAFT)
  requestVersion        Int                           @default(1)
  termsSnapshot         Json
  totalAmount           Decimal                       @db.Decimal(14, 2)
