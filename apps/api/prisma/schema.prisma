  appliedAdjustmentValue Decimal?                @db.Decimal(14, 2)
  priceResolvedAt        DateTime?
  condition              String?
  defective              Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([returnOrderId])
  @@index([productId])
  @@index([pricingPolicyVersionId])
}

model ExchangeOrder {
  id              String              @id @default(cuid())
  exchangeNumber  String              @unique
  returnOrderId   String
  branchId        String
  status          ExchangeOrderStatus @default(DRAFT)
  priceDifference Decimal             @default(0) @db.Decimal(14, 2)
  createdById     String
  completedAt     DateTime?
  items           ExchangeOrderItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([returnOrderId])
  @@index([branchId])
  @@index([status])
}

model ExchangeOrderItem {
  id           String        @id @default(cuid())
  exchangeId   String
  exchange     ExchangeOrder @relation(fields: [exchangeId], references: [id])
  oldProductId String?
  newProductId String
  sku          String
  productName  String
  quantity     Int
  unitPrice    Decimal       @default(0) @db.Decimal(14, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([exchangeId])
  @@index([newProductId])
}

model WarrantyClaim {
  id            String              @id @default(cuid())
  claimNumber   String              @unique
  branchId      String
  customerId    String
  productId     String
  sku           String
  serialNumber  String?
  saleId        String?
  soldAt        DateTime?
  soldById      String?
  installedById String?
  warrantyUntil DateTime?
  status        WarrantyClaimStatus @default(PENDING)
  reason        String
  decision      String?
  note          String?
  hqReceivedAt  DateTime?
  inspectedById String?
  hqDecision    HqWarrantyDecision?
  hqResult      String?
  items         WarrantyClaimItem[]
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([customerId])
  @@index([productId])
  @@index([saleId])
  @@index([status])
}

model WarrantyClaimItem {
  id          String        @id @default(cuid())
  claimId     String
  claim       WarrantyClaim @relation(fields: [claimId], references: [id])
  productId   String
  sku         String
  productName String
  quantity    Int           @default(1)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([claimId])
  @@index([productId])
}

model SupplierClaim {
  id                 String                @id @default(cuid())
  claimNumber        String                @unique
  supplierId         String?
  factoryId          String?
  procurementOrderId String?
  productId          String
  sku                String
  quantity           Int
  reason             String
  evidencePhotos     String[]
  claimAmount        Decimal               @default(0) @db.Decimal(14, 2)
  status             SupplierClaimStatus   @default(DRAFT)
  outcome            SupplierClaimOutcome?
  createdById        String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  @@index([supplierId])
  @@index([factoryId])
  @@index([procurementOrderId])
  @@index([productId])
  @@index([status])
}

model Alert {
  id              String              @id @default(cuid())
  branchId        String?
  type            AlertType
  module          NotificationModule?
  recipientRole   Role?
  recipientUserId String?
  referenceNumber String?
  title           String
  message         String
  entityType      String?
  entityId        String?
  status          AlertStatus         @default(UNREAD)
  createdAt       DateTime            @default(now())
  readAt          DateTime?
  resolvedAt      DateTime?
  archivedAt      DateTime?

  @@index([branchId])
  @@index([type])
  @@index([module])
  @@index([recipientRole])
  @@index([recipientUserId])
  @@index([status])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([referenceNumber])
}

enum FinanceAccountScope {
  HQ
  BRANCH
}

enum FinanceAccountStatus {
  DRAFT
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVE_REQUESTED
  ARCHIVED
}

enum FinanceLedgerEntryType {
  OPENING_BALANCE
  OWNER_INVESTMENT
  CAPITAL_INJECTION
  TRANSFER_IN
  TRANSFER_OUT
  INCOME
  EXPENSE
  PAYMENT
  REFUND
  ADJUSTMENT
  CLOSING_BALANCE
}

enum FinanceInvestmentType {
  OWNER_INVESTMENT
  INVESTOR_INVESTMENT
}

enum FinanceTransferStatus {
  DRAFT
  PENDING_CASHIER
  RETURNED
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

model FinanceAccountTypeDefinition {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  category  String?
  isSystem  Boolean          @default(true)
  isActive  Boolean          @default(true)
  accounts  FinanceAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model FinanceAccount {
  id                          String                        @id @default(cuid())
  accountNumber               String                        @unique
  name                        String
  scope                       FinanceAccountScope
  branchId                    String?
  branch                      Branch?                       @relation(fields: [branchId], references: [id])
  typeCode                    String
  typeDefinition              FinanceAccountTypeDefinition  @relation(fields: [typeCode], references: [code])
  currency                    String                        @default("KGS")
  status                      FinanceAccountStatus          @default(ACTIVE)
  openingBalance              Decimal                       @default(0) @db.Decimal(14, 2)
  currentBalance              Decimal                       @default(0) @db.Decimal(14, 2)
  availableBalance            Decimal                       @default(0) @db.Decimal(14, 2)
  pendingBalance              Decimal                       @default(0) @db.Decimal(14, 2)
  bankName                    String?
  bankAccountNo               String?
  iban                        String?
  swiftBic                    String?
  qrProvider                  String?
  qrMerchantId                String?
  posTerminalId               String?
  posProvider                 String?
  responsibleEmployeeId       String?
  responsibleEmployee         User?                         @relation("FinanceAccountResponsible", fields: [responsibleEmployeeId], references: [id])
  notes                       String?
  createdById                 String?
  createdBy                   User?                         @relation("FinanceAccountCreator", fields: [createdById], references: [id])
  updatedById                 String?
  updatedBy                   User?                         @relation("FinanceAccountUpdater", fields: [updatedById], references: [id])
  assignments                 FinanceAccountAssignment[]
  ledgerEntries               FinanceLedgerEntry[]
  transfersOut                FinanceTransfer[]             @relation("FinanceTransferSource")
  transfersIn                 FinanceTransfer[]             @relation("FinanceTransferDestination")
  cashierShifts               CashierShift[]
  expenses                    FinanceExpense[]
  payments                    Payment[]
  hqB2bPaymentRequests        HqB2bPaymentRequest[]
  reconciliations             FinanceReconciliation[]
  investments                 FinanceInvestment[]
  intendedProcurementPayments ProcurementSupplierPayment[]  @relation("ProcurementPaymentIntendedAccount")
  branchPayments              BranchPayment[]
  actualProcurementPayments   ProcurementSupplierPayment[]  @relation("ProcurementPaymentActualAccount")
  transportExpenses           ProcurementTransportExpense[] @relation("TransportExpenseFinanceAccount")
  installmentEarlyPayments    BranchInstallmentEarlyPaymentRequest[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  deletedAt                   DateTime?

  @@index([branchId])
  @@index([scope])
  @@index([typeCode])
  @@index([status])
  @@index([currency])
}

model FinanceAccountAssignment {
  id                String         @id @default(cuid())
  accountId         String
  account           FinanceAccount @relation(fields: [accountId], references: [id])
  userId            String
  user              User           @relation("FinanceAccountAssignmentUser", fields: [userId], references: [id])
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  assignedById      String?
  assignedBy        User?          @relation("FinanceAccountAssignmentCreator", fields: [assignedById], references: [id])
  isActive          Boolean        @default(true)
  isPrimary         Boolean        @default(false)
  allowedOperations String[]       @default([])
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([branchId])
  @@index([isActive])
}

model FinanceLedgerEntry {
  id                         String                       @id @default(cuid())
  entryNumber                String                       @unique
  accountId                  String
  account                    FinanceAccount               @relation(fields: [accountId], references: [id])
  branchId                   String?
  branch                     Branch?                      @relation(fields: [branchId], references: [id])
  entryType                  FinanceLedgerEntryType
  amount                     Decimal                      @db.Decimal(14, 2)
  signedAmount               Decimal                      @db.Decimal(14, 2)
  beforeBalance              Decimal                      @db.Decimal(14, 2)
  afterBalance               Decimal                      @db.Decimal(14, 2)
  currency                   String                       @default("KGS")
  transferId                 String?
  transfer                   FinanceTransfer?             @relation(fields: [transferId], references: [id])
  referenceType              String?
  referenceId                String?
  notes                      String?
  createdById                String?
  createdBy                  User?                        @relation("FinanceLedgerEntryCreator", fields: [createdById], references: [id])
  createdAt                  DateTime                     @default(now())
  financeInvestment          FinanceInvestment?
  procurementSupplierPayment ProcurementSupplierPayment?  @relation("ProcurementSupplierPaymentLedgerEntry")
  transportExpense           ProcurementTransportExpense? @relation("TransportExpenseLedgerEntry")
  branchPayment              BranchPayment?

  @@index([accountId])
  @@index([branchId])
  @@index([entryType])
  @@index([transferId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model FinanceTransfer {
  id                   String                @id @default(cuid())
  transferNumber       String                @unique
  sourceAccountId      String
  sourceAccount        FinanceAccount        @relation("FinanceTransferSource", fields: [sourceAccountId], references: [id])
  destinationAccountId String
  destinationAccount   FinanceAccount        @relation("FinanceTransferDestination", fields: [destinationAccountId], references: [id])
  branchId             String?
  branch               Branch?               @relation(fields: [branchId], references: [id])
  amount               Decimal               @db.Decimal(14, 2)
  currency             String                @default("KGS")
  transferDate         DateTime              @default(now())
  status               FinanceTransferStatus @default(DRAFT)
  requiresApproval     Boolean               @default(true)
  reason               String?
  notes                String?
  transactionNumber    String?
  version              Int                   @default(1)
  idempotencyKey       String?               @unique
  sentToCashierAt      DateTime?
  completedAt          DateTime?
  returnedAt           DateTime?
  returnReason         String?
  createdById          String?
  createdBy            User?                 @relation("FinanceTransferCreator", fields: [createdById], references: [id])
  accountantId         String?
  accountant           User?                 @relation("FinanceTransferAccountant", fields: [accountantId], references: [id])
  cashierId            String?
  cashier              User?                 @relation("FinanceTransferCashier", fields: [cashierId], references: [id])
  returnedById         String?
  returnedBy           User?                 @relation("FinanceTransferReturnedBy", fields: [returnedById], references: [id])
  approvedById         String?
  approvedBy           User?                 @relation("FinanceTransferApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  reversalOfTransferId String?
  reversalOfTransfer   FinanceTransfer?      @relation("FinanceTransferReversal", fields: [reversalOfTransferId], references: [id])
  reversals            FinanceTransfer[]     @relation("FinanceTransferReversal")
  ledgerEntries        FinanceLedgerEntry[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([branchId])
  @@index([status])
  @@index([transferDate])
  @@index([accountantId])
  @@index([cashierId])
  @@index([sentToCashierAt])
}

model CashierShift {
  id              String             @id @default(cuid())
  shiftNumber     String             @unique
  cashierId       String
  cashier         User               @relation("CashierShiftCashier", fields: [cashierId], references: [id])
  branchId        String
  branch          Branch             @relation(fields: [branchId], references: [id])
  accountId       String
  account         FinanceAccount     @relation(fields: [accountId], references: [id])
  status          CashierShiftStatus @default(OPEN)
  openingBalance  Decimal            @db.Decimal(14, 2)
  expectedBalance Decimal            @default(0) @db.Decimal(14, 2)
  actualBalance   Decimal?           @db.Decimal(14, 2)
  closingBalance  Decimal?           @db.Decimal(14, 2)
  difference      Decimal?           @db.Decimal(14, 2)
  comments        String?
  openedAt        DateTime           @default(now())
  closedAt        DateTime?

  @@index([cashierId])
  @@index([branchId])
  @@index([accountId])
  @@index([status])
  @@index([openedAt])
}

enum FinanceExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum FinanceReconciliationStatus {
  PENDING
  COMPLETED
  DIFFERENCE
  REJECTED
}

model FinanceExpense {
  id             String               @id @default(cuid())
  expenseNumber  String               @unique
  category       String
  accountId      String
  account        FinanceAccount       @relation(fields: [accountId], references: [id])
  branchId       String?
  branch         Branch?              @relation(fields: [branchId], references: [id])
  amount         Decimal              @db.Decimal(14, 2)
  currency       String               @default("KGS")
  payee          String?
  purpose        String?
  documentNumber String?
  attachmentUrl  String?
  expenseDate    DateTime             @default(now())
  status         FinanceExpenseStatus @default(PAID)
  notes          String?
  ledgerEntryId  String?
  createdById    String?
  createdBy      User?                @relation("FinanceExpenseCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?                @relation("FinanceExpenseApprover", fields: [approvedById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([accountId])
  @@index([branchId])
  @@index([status])
  @@index([expenseDate])
  @@index([category])
}

model FinanceReconciliation {
  id                   String                      @id @default(cuid())
  reconciliationNumber String                      @unique
  accountId            String
  account              FinanceAccount              @relation(fields: [accountId], references: [id])
  branchId             String?
  branch               Branch?                     @relation(fields: [branchId], references: [id])
  statementDate        DateTime
  systemBalance        Decimal                     @db.Decimal(14, 2)
  actualBalance        Decimal                     @db.Decimal(14, 2)
  difference           Decimal                     @db.Decimal(14, 2)
  status               FinanceReconciliationStatus @default(PENDING)
  notes                String?
  attachmentUrl        String?
  createdById          String?
  createdBy            User?                       @relation("FinanceReconciliationCreator", fields: [createdById], references: [id])
  completedAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([accountId])
  @@index([branchId])
  @@index([status])
  @@index([statementDate])
}

model FinanceInvestment {
  id                String                @id @default(cuid())
  investmentNumber  String                @unique
  investmentDate    DateTime
  investmentType    FinanceInvestmentType
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("KGS")
  accountId         String
  account           FinanceAccount        @relation(fields: [accountId], references: [id])
  branchId          String?
  branch            Branch?               @relation(fields: [branchId], references: [id])
  investorOwnerName String
  notes             String?
  ledgerEntryId     String                @unique
  ledgerEntry       FinanceLedgerEntry    @relation(fields: [ledgerEntryId], references: [id])
  createdById       String?
  createdBy         User?                 @relation("FinanceInvestmentCreator", fields: [createdById], references: [id])
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?                 @relation("FinanceInvestmentDeletedBy", fields: [deletedById], references: [id])
  deletionReason    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([accountId])
  @@index([branchId])
  @@index([investmentType])
  @@index([investmentDate])
  @@index([createdAt])
  @@index([deletedAt])
}

enum FranchiseExpansionStatus {
  LEAD
  NEGOTIATION
  AGREEMENT
  PREPARING
  OPENING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FranchiseSupportTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model FranchiseExpansionLead {
  id                   String                   @id @default(cuid())
  fullName             String
  phone                String
  city                 String?
  region               String?
  status               FranchiseExpansionStatus @default(LEAD)
  agreementStatus      String?
  documentsNote        String?
  plannedOpeningDate   DateTime?
  responsibleManagerId String?
  responsibleManager   User?                    @relation("FranchiseExpansionResponsible", fields: [responsibleManagerId], references: [id])
  notes                String?
  createdById          String
  createdBy            User                     @relation("FranchiseExpansionCreator", fields: [createdById], references: [id])
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([region])
  @@index([responsibleManagerId])
  @@index([createdById])
}

model FranchiseSupportTask {
  id             String                     @id @default(cuid())
  title          String
  description    String?
  status         FranchiseSupportTaskStatus @default(OPEN)
  assigneeRole   String?
  assigneeUserId String?
  assigneeUser   User?                      @relation("FranchiseSupportTaskAssignee", fields: [assigneeUserId], references: [id])
  branchId       String?
  branch         Branch?                    @relation(fields: [branchId], references: [id])
  dueAt          DateTime?
  completedAt    DateTime?
  createdById    String
  createdBy      User                       @relation("FranchiseSupportTaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([assigneeUserId])
  @@index([createdById])
  @@index([dueAt])
}
