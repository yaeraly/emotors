model Branch {
  id                        String                        @id @default(cuid())
  name                      String
  code                      String                        @unique
  city                      String?
  address                   String?
  phone                     String?
  ownerName                 String?
  status                    BranchStatus                  @default(ACTIVE)
  openedAt                  DateTime?
  users                     User[]
  customers                 Customer[]
  customerEvents            CustomerEvent[]
  followUps                 FollowUp[]
  sales                     Sale[]
  payments                  Payment[]
  installments              InstallmentSchedule[]
  saleInstallmentApprovals  SaleInstallmentApproval[]
  saleInstallmentPayments   SaleInstallmentPayment[]
  receipts                  Receipt[]
  warehouses                Warehouse[]
  products                  Product[]
  stockMovements            StockMovement[]
  inventoryBalances         InventoryBalance[]
  kpiSnapshots              KpiSnapshot[]
  kpiTargets                BranchKpiTarget[]
  npsSurveys                NpsSurvey[]
  academyStudents           Student[]
  royaltyRules              RoyaltyRule[]
  royaltyInvoices           RoyaltyInvoice[]
