generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  MASTER
  ACCOUNTANT
}

enum CustomerStatus {
  NEW
  ACTIVE
  VIP
  SLEEPING
  RISK
}

enum CustomerEventType {
  NOTE
  CALL
  WHATSAPP
  VISIT
  SALE
  SERVICE
  FOLLOW_UP
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DEBT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum ServiceStatus {
  NEW
  DIAGNOSTIC
  IN_PROGRESS
  WAITING_PARTS
  DONE
  CANCELLED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  SERVICE
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  SALE_PAYMENT
  DEBT_PAYMENT
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  customers   Customer[]
  sales       Sale[]
  products    Product[]
  warehouses  Warehouse[]
  cashboxes   Cashbox[]
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  role             Role
  branchId         String
  refreshTokenHash String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id])
}

model Customer {
  id                  String          @id @default(cuid())
  fullName            String
  phone               String
  whatsappPhone       String?
  branchId            String
  status              CustomerStatus  @default(NEW)
  totalPurchaseAmount Decimal         @default(0) @db.Decimal(14, 2)
  totalProfitAmount   Decimal         @default(0) @db.Decimal(14, 2)
  totalDebtAmount     Decimal         @default(0) @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  branch              Branch          @relation(fields: [branchId], references: [id])
  events              CustomerEvent[]
  followUps           FollowUp[]
  sales               Sale[]
  serviceOrders       ServiceOrder[]

  @@index([branchId])
  @@index([phone])
}

model CustomerEvent {
  id         String            @id @default(cuid())
  customerId String
  branchId   String
  type       CustomerEventType @default(NOTE)
  title      String
  details    String?
  createdAt  DateTime          @default(now())
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([branchId])
}

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  branchId    String
  title       String
  dueAt       DateTime
  status      FollowUpStatus @default(OPEN)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([branchId])
}

model Sale {
  id            String        @id @default(cuid())
  branchId      String
  customerId    String?
  number        String        @unique
  status        SaleStatus    @default(COMPLETED)
  paymentStatus PaymentStatus @default(DEBT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  profit        Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  debtAmount    Decimal       @default(0) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branch        Branch        @relation(fields: [branchId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  payments      Payment[]
  installments  InstallmentSchedule[]
  receipt       Receipt?

  @@index([branchId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  branchId       String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(14, 2)
  unitCost       Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @db.Decimal(14, 2)
  profit         Decimal  @default(0) @db.Decimal(14, 2)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([branchId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  branchId  String
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(CASH)
  note      String?
  paidAt    DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([branchId])
}

model InstallmentSchedule {
  id        String            @id @default(cuid())
  saleId    String
  branchId  String
  dueDate   DateTime
  amount    Decimal           @db.Decimal(14, 2)
  paidAmount Decimal          @default(0) @db.Decimal(14, 2)
  status    InstallmentStatus @default(PENDING)
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([branchId])
}

model Receipt {
  id        String   @id @default(cuid())
  saleId    String   @unique
  branchId  String
  number    String   @unique
  qrPayload String
  issuedAt  DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model ServiceOrder {
  id             String        @id @default(cuid())
  branchId       String
  customerId     String?
  assignedUserId String?
  number         String        @unique
  status         ServiceStatus @default(NEW)
  vehicleInfo    String?
  problem        String
  diagnostic     String?
  estimatedCost  Decimal       @default(0) @db.Decimal(14, 2)
  finalCost      Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer?     @relation(fields: [customerId], references: [id])
  tasks          ServiceTask[]
  warranties     Warranty[]

  @@index([branchId])
  @@index([customerId])
}

model ServiceTask {
  id             String       @id @default(cuid())
  serviceOrderId String
  branchId       String
  title          String
  description    String?
  laborCost      Decimal      @default(0) @db.Decimal(14, 2)
  partsCost      Decimal      @default(0) @db.Decimal(14, 2)
  status         ServiceStatus @default(NEW)
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([branchId])
}

model Warranty {
  id             String       @id @default(cuid())
  serviceOrderId String
  branchId       String
  title          String
  expiresAt      DateTime
  notes          String?
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([branchId])
}

model Product {
  id                  String   @id @default(cuid())
  branchId            String
  name                String
  sku                 String
  category            String
  photoUrl            String?
  description         String?
  weightKg            Decimal  @default(0) @db.Decimal(10, 3)
  purchasePriceYuan   Decimal  @default(0) @db.Decimal(14, 2)
  latestYuanRate      Decimal  @default(0) @db.Decimal(14, 4)
  transportCostKgs    Decimal  @default(0) @db.Decimal(14, 2)
  finalCostKgs        Decimal  @default(0) @db.Decimal(14, 2)
  sellingPriceKgs     Decimal  @default(0) @db.Decimal(14, 2)
  marginPercent       Decimal  @default(0) @db.Decimal(8, 2)
  minStockLevel       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  branch              Branch   @relation(fields: [branchId], references: [id])
  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  inventoryBalances   InventoryBalance[]
  priceHistory        ProductPriceHistory[]
  analyticsSnapshots  ProductAnalyticsSnapshot[]

  @@unique([branchId, sku])
  @@index([branchId])
}

model Warehouse {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  code        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  movements   StockMovement[]
  balances    InventoryBalance[]

  @@unique([branchId, code])
  @@index([branchId])
}

model StockMovement {
  id          String            @id @default(cuid())
  branchId    String
  productId   String
  warehouseId String
  type        StockMovementType
  quantity    Int
  unitCost    Decimal           @default(0) @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryBalance {
  id          String    @id @default(cuid())
  branchId    String
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([branchId])
}

model ProductPriceHistory {
  id              String   @id @default(cuid())
  branchId        String
  productId       String
  oldPriceKgs     Decimal  @default(0) @db.Decimal(14, 2)
  newPriceKgs     Decimal  @db.Decimal(14, 2)
  changedAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([productId])
}

model YuanRateHistory {
  id        String   @id @default(cuid())
  branchId  String
  rate      Decimal  @db.Decimal(14, 4)
  validFrom DateTime @default(now())

  @@index([branchId])
}

model Cashbox {
  id           String   @id @default(cuid())
  branchId     String
  name         String
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id])
  incomes      Income[]
  expenses     Expense[]
  transactions FinanceTransaction[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Income {
  id          String   @id @default(cuid())
  branchId    String
  cashboxId   String?
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  source      String?
  createdAt   DateTime @default(now())
  cashbox     Cashbox?  @relation(fields: [cashboxId], references: [id])

  @@index([branchId])
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  cashboxId   String?
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  category    String?
  createdAt   DateTime @default(now())
  cashbox     Cashbox?  @relation(fields: [cashboxId], references: [id])

  @@index([branchId])
}

model FinanceTransaction {
  id          String                 @id @default(cuid())
  branchId    String
  cashboxId   String?
  type        FinanceTransactionType
  amount      Decimal                @db.Decimal(14, 2)
  description String?
  createdAt   DateTime               @default(now())
  cashbox     Cashbox?                @relation(fields: [cashboxId], references: [id])

  @@index([branchId])
}

model ProductAnalyticsSnapshot {
  id             String   @id @default(cuid())
  branchId       String
  productId      String
  periodStart    DateTime
  periodEnd      DateTime
  unitsSold      Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(14, 2)
  profit         Decimal  @default(0) @db.Decimal(14, 2)
  abcClass       String?
  xyzClass       String?
  marginPercent  Decimal  @default(0) @db.Decimal(8, 2)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([branchId])
  @@index([productId])
}
