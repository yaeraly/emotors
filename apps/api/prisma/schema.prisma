generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  MASTER
  ACCOUNTANT
}

enum CustomerStatus {
  NEW
  ACTIVE
  VIP
  SLEEPING
  RISK
  INACTIVE
}

enum CustomerEventType {
  NOTE
  CALL
  WHATSAPP
  VISIT
  SALE
  SERVICE
  FOLLOW_UP
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DEBT
}

enum PaymentMethod {
  CASH
  QR
  CARD
  BANK_TRANSFER
  MBANK
  ELCART
  BALANCE
}

enum SaleStatus {
  DRAFT
  SENT_TO_CUSTOMER
  APPROVED_BY_CUSTOMER
  FINALIZED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  users          User[]
  customers      Customer[]
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]
  payments       Payment[]
  installments   InstallmentSchedule[]
  receipts       Receipt[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  fullName       String
  role           Role            @default(MANAGER)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]          @relation("SaleSeller")
  payments       Payment[]       @relation("PaymentCreator")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId])
}

model Customer {
  id                  String          @id @default(cuid())
  fullName            String
  phone               String
  whatsappPhone       String?
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id])
  status              CustomerStatus  @default(NEW)
  notes               String?
  totalPurchaseAmount Decimal         @default(0) @db.Decimal(14, 2)
  totalProfitAmount   Decimal         @default(0) @db.Decimal(14, 2)
  totalDebtAmount     Decimal         @default(0) @db.Decimal(14, 2)
  events              CustomerEvent[]
  followUps           FollowUp[]
  sales               Sale[]
  payments            Payment[]
  installments        InstallmentSchedule[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  @@index([branchId])
  @@index([branchId, status])
  @@index([fullName])
  @@index([phone])
  @@index([whatsappPhone])
}

model CustomerEvent {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  type        CustomerEventType
  message     String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
}

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpStatus @default(OPEN)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Sale {
  id              String                @id @default(cuid())
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])
  sellerId        String
  seller          User                  @relation("SaleSeller", fields: [sellerId], references: [id])
  receiptNumber   String                @unique
  saleDate        DateTime              @default(now())
  totalAmount     Decimal               @default(0) @db.Decimal(14, 2)
  totalCost       Decimal               @default(0) @db.Decimal(14, 2)
  profitAmount    Decimal               @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(14, 2)
  debtAmount      Decimal               @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus         @default(DEBT)
  status          SaleStatus            @default(DRAFT)
  draftReceiptText String?
  whatsappMessageText String?
  sentToCustomerAt DateTime?
  approvedAt      DateTime?
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  notes           String?
  items           SaleItem[]
  payments        Payment[]
  installments    InstallmentSchedule[]
  receipt         Receipt?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([branchId])
  @@index([customerId])
  @@index([sellerId])
  @@index([paymentStatus])
  @@index([status])
  @@index([saleDate])
  @@index([receiptNumber])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id])
  productName  String
  productSku   String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(14, 2)
  unitCost     Decimal  @db.Decimal(14, 2)
  totalPrice   Decimal  @db.Decimal(14, 2)
  totalCost    Decimal  @db.Decimal(14, 2)
  profitAmount Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  @@index([saleId])
}

model Payment {
  id          String        @id @default(cuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paidAt      DateTime      @default(now())
  note        String?
  createdById String
  createdBy   User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([createdById])
  @@index([paidAt])
  @@index([method])
}

model InstallmentSchedule {
  id         String            @id @default(cuid())
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  saleId     String
  sale       Sale              @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  paidAmount Decimal           @default(0) @db.Decimal(14, 2)
  status     InstallmentStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model Receipt {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  saleId        String    @unique
  sale          Sale      @relation(fields: [saleId], references: [id])
  receiptNumber String    @unique
  qrCodeData    String
  printedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([branchId])
  @@index([receiptNumber])
}
