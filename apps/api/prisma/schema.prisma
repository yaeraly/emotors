model Branch {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  city           String?
  address        String?
  phone          String?
  ownerName      String?
  status         BranchStatus    @default(ACTIVE)
  openedAt       DateTime?
  users          User[]
  customers      Customer[]
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]
  payments       Payment[]
  installments   InstallmentSchedule[]
  receipts       Receipt[]
  warehouses     Warehouse[]
  products       Product[]
  stockMovements StockMovement[]
  inventoryBalances InventoryBalance[]
  kpiSnapshots   KpiSnapshot[]
  kpiTargets     BranchKpiTarget[]
  npsSurveys     NpsSurvey[]
  academyStudents Student[]
  royaltyRules   RoyaltyRule[]
  royaltyInvoices RoyaltyInvoice[]
  royaltyPayments RoyaltyPayment[]
  purchaseOrders PurchaseOrder[]
  stockTransferFrom StockTransfer[] @relation("StockTransferFromBranch")
  stockTransferTo StockTransfer[] @relation("StockTransferToBranch")
  distributionOrders BranchDistributionOrder[]
  goodsReceivings GoodsReceiving[]
  shortageReports ShortageReport[]
  branchInvoices BranchInvoice[]
  branchPayments BranchPayment[]
  branchAccountBalance BranchAccountBalance?
  serviceOrders ServiceOrder[]
  serviceOrderPayments ServiceOrderPayment[]
  warranties Warranty[]
  employeeCompensationRules EmployeeCompensationRule[]
  bonusRules BonusRule[]
  payrollRecords PayrollRecord[]
  repairCommissions RepairCommission[]
  stockRequests BranchStockRequest[]
  stockForecasts StockForecast[]
  taxProfiles TaxProfile[]
  taxReports TaxReport[]
  taxPayments TaxPayment[]
  taxReminders TaxReminder[]
  aiInsights AiInsight[]
  salesForecasts SalesForecast[]
  stockRiskPredictions StockRiskPrediction[]
  customerPredictions CustomerPrediction[]
  kpiRecommendations KpiRecommendation[]
  assignedHqWarehouseId String?
  assignedHqWarehouse   Warehouse? @relation("BranchAssignedHqWarehouse", fields: [assignedHqWarehouseId], references: [id])
  branchType             BranchType @default(FRANCHISE_BRANCH)
  hqToBranchMarkupPercent Decimal @default(0) @db.Decimal(8, 2)
  hqToBranchMarkupUpdatedAt DateTime?
  pricingChangeHistory   ProductPricingChangeHistory[] @relation("PricingChangeHistoryBranch")
  branchPurchaseRequests BranchPurchaseRequest[]
  branchRequestShortages BranchRequestShortage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([assignedHqWarehouseId])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  employeeId     String?         @unique
  phone          String?         @unique
  username       String?         @unique
  passwordHash   String
  fullName       String
  role           Role            @default(MANAGER)
  status         UserStatus      @default(ACTIVE)
  mustChangePassword Boolean     @default(false)
  hasLogin           Boolean     @default(true)
  department         String?
  notes              String?
  salary             Decimal?    @db.Decimal(14, 2)
  startDate          DateTime?
  lastLoginAt        DateTime?
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]          @relation("SaleSeller")
  payments       Payment[]       @relation("PaymentCreator")
  productPriceHistory ProductPriceHistory[] @relation("ProductPriceHistoryCreator")
  productPurchasePriceHistory ProductPurchasePriceHistory[] @relation("ProductPurchasePriceHistoryChanger")
  yuanRateHistory YuanRateHistory[] @relation("YuanRateHistoryCreator")
  stockMovements StockMovement[] @relation("StockMovementCreator")
  productCategories ProductCategory[] @relation("ProductCategoryCreator")
  kpiTargets BranchKpiTarget[] @relation("KpiTargetCreator")
  npsSurveys NpsSurvey[] @relation("NpsSurveyCreator")
  courses Course[] @relation("CourseCreator")
  lessons Lesson[] @relation("LessonCreator")
  students Student[] @relation("StudentCreator")
  enrollments Enrollment[] @relation("EnrollmentCreator")
  certificates Certificate[] @relation("CertificateCreator")
  skillLevels SkillLevel[] @relation("SkillLevelCreator")
  marketingAssets MarketingAsset[] @relation("MarketingAssetCreator")
  campaigns Campaign[] @relation("CampaignCreator")
  promotions Promotion[] @relation("PromotionCreator")
  banners Banner[] @relation("BannerCreator")
  royaltyRules RoyaltyRule[] @relation("RoyaltyRuleCreator")
  royaltyInvoices RoyaltyInvoice[] @relation("RoyaltyInvoiceCreator")
  royaltyPayments RoyaltyPayment[] @relation("RoyaltyPaymentCreator")
  createdDistributionOrders BranchDistributionOrder[] @relation("DistributionOrderCreator")
  approvedDistributionOrders BranchDistributionOrder[] @relation("DistributionOrderApprover")
  goodsReceivings GoodsReceiving[] @relation("GoodsReceivingReceiver")
  shortageReports ShortageReport[] @relation("ShortageReportCreator")
  shortageResolutions ShortageResolution[] @relation("ShortageResolutionResolver")
  assignedPickingTasks HqWarehousePickingTask[] @relation("PickingTaskAssignee")
  hqWarehouseManagerAssignments HqWarehouseManagerAssignment[] @relation("HqWarehouseManagerAssignments")
  assignedHqWarehouseManagerAssignments HqWarehouseManagerAssignment[] @relation("HqWarehouseAssignmentAssigner")
  hqSalesManagerWarehouseAssignments HqSalesManagerWarehouseAssignment[] @relation("HqSalesManagerWarehouseAssignments")
  assignedHqSalesManagerWarehouseAssignments HqSalesManagerWarehouseAssignment[] @relation("HqSalesManagerWarehouseAssignmentAssigner")
  branchInvoices BranchInvoice[] @relation("BranchInvoiceCreator")
  branchPayments BranchPayment[] @relation("BranchPaymentCreator")
  createdProcurementOrders ProcurementOrder[] @relation("ProcurementOrderCreator")
  approvedProcurementOrders ProcurementOrder[] @relation("ProcurementOrderApprover")
  assignedServiceOrders ServiceOrder[] @relation("ServiceOrderMaster")
  createdServiceOrders ServiceOrder[] @relation("ServiceOrderCreator")
  uploadedServiceOrderPhotos ServiceOrderPhoto[] @relation("ServiceOrderPhotoUploader")
  serviceOrderPayments ServiceOrderPayment[] @relation("ServiceOrderPaymentCreator")
  diagnoses Diagnosis[] @relation("DiagnosisMaster")
  repairs Repair[] @relation("RepairMaster")
  partsConsumptions PartsConsumption[] @relation("PartsConsumptionCreator")
  compensationRules EmployeeCompensationRule[] @relation("EmployeeCompensationRuleEmployee")
  salesCommissions SalesCommission[] @relation("SalesCommissionEmployee")
  repairCommissions RepairCommission[] @relation("RepairCommissionEmployee")
  payrollRecords PayrollRecord[] @relation("PayrollRecordEmployee")
  employeeKpis EmployeeKPI[] @relation("EmployeeKPIEmployee")
  userRoles      UserRole[]
  assignedUserRoles UserRole[]    @relation("UserRoleAssigner")
  loginHistory   LoginHistory[]
  auditLogs      AuditLog[]
  procurementSupplierPayments ProcurementSupplierPayment[] @relation("ProcurementSupplierPaymentCreator")
  voidedProcurementSupplierPayments ProcurementSupplierPayment[] @relation("ProcurementSupplierPaymentVoider")
  fileAttachments FileAttachment[] @relation("FileAttachmentUploader")
  replacedDomesticTransportAttachments FileAttachment[] @relation("DomesticTransportAttachmentReplacer")
  procurementCostAdjustments ProcurementCostAdjustment[] @relation("ProcurementCostAdjustmentCreator")
  unlockedProcurementOrders ProcurementOrder[] @relation("ProcurementOrderUnlocker")
  chinaDomesticTransportUnlockedProcurementOrders ProcurementOrder[] @relation("ProcurementChinaDomesticTransportUnlocker")
  createdTransportCompanies TransportCompany[] @relation("TransportCompanyCreator")
  createdSvhToHqTransports ProcurementSvhToHqTransport[] @relation("SvhToHqTransportCreator")
  createdInventoryCounts InventoryCountSession[] @relation("InventoryCountCreator")
  approvedInventoryCounts InventoryCountSession[] @relation("InventoryCountApprover")
  rejectedInventoryCounts InventoryCountSession[] @relation("InventoryCountRejecter")
  createdProcurementDifferenceReports ProcurementDifferenceReport[] @relation("ProcurementDifferenceReportCreator")
  createdPricingPolicies ProductPricingPolicy[] @relation("PricingPolicyCreator")
  updatedPricingPolicies ProductPricingPolicy[] @relation("PricingPolicyUpdater")
  pricingChangeHistory ProductPricingChangeHistory[] @relation("PricingChangeHistoryChanger")
  createdBranchPurchaseRequests BranchPurchaseRequest[] @relation("BranchPurchaseRequestCreator")
  reviewedBranchPurchaseRequests BranchPurchaseRequest[] @relation("BranchPurchaseRequestReviewer")
  reviewedBranchRequestShortages BranchRequestShortage[] @relation("BranchRequestShortageReviewer")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([branchId])
  @@index([role])
  @@index([status])
}

model RbacRole {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         RbacRole   @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  roleId       String
  role         RbacRole @relation(fields: [roleId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("UserRoleAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  loginAt   DateTime @default(now())
  logoutAt  DateTime?
  ipAddress String?
  device    String?
  browser   String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([loginAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

model Customer {
  id                  String          @id @default(cuid())
  fullName            String
  phone               String
  whatsappPhone       String?
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id])
  status              CustomerStatus  @default(NEW)
  notes               String?
  totalPurchaseAmount Decimal         @default(0) @db.Decimal(14, 2)
  totalProfitAmount   Decimal         @default(0) @db.Decimal(14, 2)
  totalDebtAmount     Decimal         @default(0) @db.Decimal(14, 2)
  events              CustomerEvent[]
  followUps           FollowUp[]
  sales               Sale[]
  payments            Payment[]
  installments        InstallmentSchedule[]
  serviceOrders       ServiceOrder[]
  serviceOrderPayments ServiceOrderPayment[]
  warranties          Warranty[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  @@index([branchId])
  @@index([branchId, status])
  @@index([fullName])
  @@index([phone])
  @@index([whatsappPhone])
}

model CustomerEvent {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  type        CustomerEventType
  message     String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
}

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpStatus @default(OPEN)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Sale {
  id              String                @id @default(cuid())
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])
  sellerId        String
  seller          User                  @relation("SaleSeller", fields: [sellerId], references: [id])
  receiptNumber   String                @unique
  saleDate        DateTime              @default(now())
  totalAmount     Decimal               @default(0) @db.Decimal(14, 2)
  totalCost       Decimal               @default(0) @db.Decimal(14, 2)
