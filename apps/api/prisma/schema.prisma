generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CEO
  FRANCHISE_DIRECTOR
  FINANCE_MANAGER
  WAREHOUSE_MANAGER
  CONTENT_CREATOR
  ACADEMY_DIRECTOR
  SYSTEM_ADMINISTRATOR
  MANAGER
  MASTER
  ACCOUNTANT
  SALESPERSON
  FRANCHISE_OWNER
  WAREHOUSE_OPERATOR
  CASHIER
  ACADEMY_MANAGER
  MARKETING_MANAGER
  PROCUREMENT_MANAGER
  SUPPLY_CHAIN_MANAGER
  INVESTMENT_MANAGER
  EXPANSION_MANAGER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  NEW
  ACTIVE
  VIP
  SLEEPING
  RISK
  INACTIVE
}

enum CustomerEventType {
  NOTE
  CALL
  WHATSAPP
  VISIT
  SALE
  SERVICE
  FOLLOW_UP
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DEBT
}

enum PaymentMethod {
  CASH
  QR
  CARD
  BANK_TRANSFER
  MBANK
  ELCART
  BALANCE
}

enum SaleStatus {
  DRAFT
  SENT_TO_CUSTOMER
  APPROVED_BY_CUSTOMER
  FINALIZED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  SALE
  SERVICE_USE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MarketingAssetType {
  REELS_SCRIPT
  POST
  BANNER
  PHOTO
  VIDEO
  WHATSAPP_TEXT
  AD_COPY
}

enum MarketingLanguage {
  KY
  RU
  EN
}

enum RoyaltyRuleType {
  PERCENT_OF_REVENUE
  PERCENT_OF_PROFIT
  FIXED_MONTHLY
}

enum RoyaltyInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PAID
  IN_PRODUCTION
  SHIPPED_TO_YIWU
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

enum ProcurementOrderStatus {
  DRAFT
  APPROVED
  PAID
  IN_PRODUCTION
  SHIPPED_TO_YIWU
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  APPROVED
  SENT
  RECEIVED
  CANCELLED
}

enum BranchDistributionOrderStatus {
  DRAFT
  APPROVED
  SENT
  RECEIVED
  RECEIVED_WITH_DIFFERENCE
  CANCELLED
}

enum GoodsReceivingStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ShortageReportStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum ShortageReportItemType {
  SHORTAGE
  OVERAGE
}

enum BranchInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BranchPaymentMethod {
  CASH
  QR
  BANK
  TRANSFER
  INSTALLMENT
  BALANCE
}

enum InvestmentDealStatus {
  NEW
  IN_DISCUSSION
  DOCUMENTS
  DEPOSIT_PAID
  ACTIVE
  CLOSED
  LOST
}

enum FranchiseApplicationStatus {
  NEW
  REVIEW
  APPROVED
  REJECTED
  OPENED
}

enum TaxReportStatus {
  DRAFT
  READY
  SUBMITTED
  PAID
  OVERDUE
}

enum AiInsightType {
  SALES_FORECAST
  STOCK_RISK
  CUSTOMER_RETURN
  KPI_RECOMMENDATION
  BRANCH_ALERT
  SLOW_MOVING_PRODUCT
}

enum ServiceOrderStatus {
  NEW
  DIAGNOSIS
  IN_REPAIR
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum RepairStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BonusType {
  FIXED
  PERCENT
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  city           String?
  address        String?
  phone          String?
  ownerName      String?
  status         BranchStatus    @default(ACTIVE)
  openedAt       DateTime?
  users          User[]
  customers      Customer[]
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]
  payments       Payment[]
  installments   InstallmentSchedule[]
  receipts       Receipt[]
  warehouses     Warehouse[]
  products       Product[]
  stockMovements StockMovement[]
  inventoryBalances InventoryBalance[]
  kpiSnapshots   KpiSnapshot[]
  kpiTargets     BranchKpiTarget[]
  npsSurveys     NpsSurvey[]
  academyStudents Student[]
  royaltyRules   RoyaltyRule[]
  royaltyInvoices RoyaltyInvoice[]
  royaltyPayments RoyaltyPayment[]
  purchaseOrders PurchaseOrder[]
  stockTransferFrom StockTransfer[] @relation("StockTransferFromBranch")
  stockTransferTo StockTransfer[] @relation("StockTransferToBranch")
  distributionOrders BranchDistributionOrder[]
  goodsReceivings GoodsReceiving[]
  shortageReports ShortageReport[]
  branchInvoices BranchInvoice[]
  branchPayments BranchPayment[]
  branchAccountBalance BranchAccountBalance?
  serviceOrders ServiceOrder[]
  warranties Warranty[]
  employeeCompensationRules EmployeeCompensationRule[]
  bonusRules BonusRule[]
  payrollRecords PayrollRecord[]
  repairCommissions RepairCommission[]
  stockRequests BranchStockRequest[]
  stockForecasts StockForecast[]
  taxProfiles TaxProfile[]
  taxReports TaxReport[]
  taxPayments TaxPayment[]
  taxReminders TaxReminder[]
  aiInsights AiInsight[]
  salesForecasts SalesForecast[]
  stockRiskPredictions StockRiskPrediction[]
  customerPredictions CustomerPrediction[]
  kpiRecommendations KpiRecommendation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  employeeId     String?         @unique
  phone          String?         @unique
  username       String?         @unique
  passwordHash   String
  fullName       String
  role           Role            @default(MANAGER)
  status         UserStatus      @default(ACTIVE)
  mustChangePassword Boolean     @default(false)
  lastLoginAt    DateTime?
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  customerEvents CustomerEvent[]
  followUps      FollowUp[]
  sales          Sale[]          @relation("SaleSeller")
  payments       Payment[]       @relation("PaymentCreator")
  productPriceHistory ProductPriceHistory[] @relation("ProductPriceHistoryCreator")
  yuanRateHistory YuanRateHistory[] @relation("YuanRateHistoryCreator")
  stockMovements StockMovement[] @relation("StockMovementCreator")
  productCategories ProductCategory[] @relation("ProductCategoryCreator")
  kpiTargets BranchKpiTarget[] @relation("KpiTargetCreator")
  npsSurveys NpsSurvey[] @relation("NpsSurveyCreator")
  courses Course[] @relation("CourseCreator")
  lessons Lesson[] @relation("LessonCreator")
  students Student[] @relation("StudentCreator")
  enrollments Enrollment[] @relation("EnrollmentCreator")
  certificates Certificate[] @relation("CertificateCreator")
  skillLevels SkillLevel[] @relation("SkillLevelCreator")
  marketingAssets MarketingAsset[] @relation("MarketingAssetCreator")
  campaigns Campaign[] @relation("CampaignCreator")
  promotions Promotion[] @relation("PromotionCreator")
  banners Banner[] @relation("BannerCreator")
  royaltyRules RoyaltyRule[] @relation("RoyaltyRuleCreator")
  royaltyInvoices RoyaltyInvoice[] @relation("RoyaltyInvoiceCreator")
  royaltyPayments RoyaltyPayment[] @relation("RoyaltyPaymentCreator")
  createdDistributionOrders BranchDistributionOrder[] @relation("DistributionOrderCreator")
  approvedDistributionOrders BranchDistributionOrder[] @relation("DistributionOrderApprover")
  goodsReceivings GoodsReceiving[] @relation("GoodsReceivingReceiver")
  shortageReports ShortageReport[] @relation("ShortageReportCreator")
  branchInvoices BranchInvoice[] @relation("BranchInvoiceCreator")
  branchPayments BranchPayment[] @relation("BranchPaymentCreator")
  createdProcurementOrders ProcurementOrder[] @relation("ProcurementOrderCreator")
  approvedProcurementOrders ProcurementOrder[] @relation("ProcurementOrderApprover")
  assignedServiceOrders ServiceOrder[] @relation("ServiceOrderMaster")
  createdServiceOrders ServiceOrder[] @relation("ServiceOrderCreator")
  diagnoses Diagnosis[] @relation("DiagnosisMaster")
  repairs Repair[] @relation("RepairMaster")
  partsConsumptions PartsConsumption[] @relation("PartsConsumptionCreator")
  compensationRules EmployeeCompensationRule[] @relation("EmployeeCompensationRuleEmployee")
  salesCommissions SalesCommission[] @relation("SalesCommissionEmployee")
  repairCommissions RepairCommission[] @relation("RepairCommissionEmployee")
  payrollRecords PayrollRecord[] @relation("PayrollRecordEmployee")
  employeeKpis EmployeeKPI[] @relation("EmployeeKPIEmployee")
  userRoles      UserRole[]
  assignedUserRoles UserRole[]    @relation("UserRoleAssigner")
  loginHistory   LoginHistory[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([branchId])
  @@index([role])
  @@index([status])
}

model RbacRole {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         RbacRole   @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  roleId       String
  role         RbacRole @relation(fields: [roleId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("UserRoleAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  loginAt   DateTime @default(now())
  logoutAt  DateTime?
  ipAddress String?
  device    String?
  browser   String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([loginAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

model Customer {
  id                  String          @id @default(cuid())
  fullName            String
  phone               String
  whatsappPhone       String?
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id])
  status              CustomerStatus  @default(NEW)
  notes               String?
  totalPurchaseAmount Decimal         @default(0) @db.Decimal(14, 2)
  totalProfitAmount   Decimal         @default(0) @db.Decimal(14, 2)
  totalDebtAmount     Decimal         @default(0) @db.Decimal(14, 2)
  events              CustomerEvent[]
  followUps           FollowUp[]
  sales               Sale[]
  payments            Payment[]
  installments        InstallmentSchedule[]
  serviceOrders       ServiceOrder[]
  warranties          Warranty[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  @@index([branchId])
  @@index([branchId, status])
  @@index([fullName])
  @@index([phone])
  @@index([whatsappPhone])
}

model CustomerEvent {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  type        CustomerEventType
  message     String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
}

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpStatus @default(OPEN)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Sale {
  id              String                @id @default(cuid())
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])
  sellerId        String
  seller          User                  @relation("SaleSeller", fields: [sellerId], references: [id])
  receiptNumber   String                @unique
  saleDate        DateTime              @default(now())
  totalAmount     Decimal               @default(0) @db.Decimal(14, 2)
  totalCost       Decimal               @default(0) @db.Decimal(14, 2)
  profitAmount    Decimal               @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(14, 2)
  debtAmount      Decimal               @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus         @default(DEBT)
  status          SaleStatus            @default(DRAFT)
  draftReceiptText String?
  whatsappMessageText String?
  sentToCustomerAt DateTime?
  approvedAt      DateTime?
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  notes           String?
  items           SaleItem[]
  payments        Payment[]
  installments    InstallmentSchedule[]
  receipt         Receipt?
  salesCommissions SalesCommission[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([branchId])
  @@index([customerId])
  @@index([sellerId])
  @@index([paymentStatus])
  @@index([status])
  @@index([saleDate])
  @@index([receiptNumber])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id])
  productName  String
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productSku   String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(14, 2)
  unitCost     Decimal  @db.Decimal(14, 2)
  totalPrice   Decimal  @db.Decimal(14, 2)
  totalCost    Decimal  @db.Decimal(14, 2)
  profitAmount Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paidAt      DateTime      @default(now())
  note        String?
  createdById String
  createdBy   User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([createdById])
  @@index([paidAt])
  @@index([method])
}

model InstallmentSchedule {
  id         String            @id @default(cuid())
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  saleId     String
  sale       Sale              @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  paidAmount Decimal           @default(0) @db.Decimal(14, 2)
  status     InstallmentStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([branchId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model Receipt {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  saleId        String    @unique
  sale          Sale      @relation(fields: [saleId], references: [id])
  receiptNumber String    @unique
  qrCodeData    String
  printedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([branchId])
  @@index([receiptNumber])
}

model Warehouse {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  code      String
  address   String?
  isActive  Boolean   @default(true)
  products  Product[]
  stockMovements StockMovement[]
  inventoryBalances InventoryBalance[]
  sourceDistributionOrders BranchDistributionOrder[] @relation("DistributionSourceWarehouse")
  destinationDistributionOrders BranchDistributionOrder[] @relation("DistributionDestinationWarehouse")
  goodsReceivings GoodsReceiving[]
  shortageReports ShortageReport[]
  partsConsumptions PartsConsumption[]
  procurementOrders ProcurementOrder[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([branchId, code])
  @@index([branchId])
}

model Product {
  id                String    @id @default(cuid())
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  categoryId        String
  productCategory   ProductCategory @relation(fields: [categoryId], references: [id])
  name              String
  sku               String
  category          String
  photoUrl          String?
  description       String?
  characteristics   Json?
  weightKg          Decimal   @default(0) @db.Decimal(14, 3)
  purchasePriceYuan Decimal   @default(0) @db.Decimal(14, 2)
  latestYuanRate    Decimal   @default(0) @db.Decimal(14, 4)
  purchaseCostKgs   Decimal   @default(0) @db.Decimal(14, 2)
  transportCostKgs  Decimal   @default(0) @db.Decimal(14, 2)
  finalCostKgs      Decimal   @default(0) @db.Decimal(14, 2)
  sellingPriceKgs   Decimal   @default(0) @db.Decimal(14, 2)
  marginAmount      Decimal   @default(0) @db.Decimal(14, 2)
  marginPercent     Decimal   @default(0) @db.Decimal(8, 2)
  minStockLevel     Int       @default(0)
  isActive          Boolean   @default(true)
  priceHistory      ProductPriceHistory[]
  stockMovements    StockMovement[]
  inventoryBalances InventoryBalance[]
  saleItems         SaleItem[]
  distributionOrderItems BranchDistributionOrderItem[]
  goodsReceivingItems GoodsReceivingItem[]
  shortageReportItems ShortageReportItem[]
  partsConsumptions PartsConsumption[]
  warranties Warranty[]
  procurementOrderItems ProcurementOrderItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([category])
  @@index([isActive])
}

model ProductCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  nameKy      String
  nameRu      String
  nameEn      String
  description String?
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation("ProductCategoryCreator", fields: [createdById], references: [id])
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
}

model ProductPriceHistory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  purchasePriceYuan Decimal  @db.Decimal(14, 2)
  yuanRate          Decimal  @db.Decimal(14, 4)
  purchaseCostKgs   Decimal  @db.Decimal(14, 2)
  transportCostKgs  Decimal  @db.Decimal(14, 2)
  finalCostKgs      Decimal  @db.Decimal(14, 2)
  sellingPriceKgs   Decimal  @db.Decimal(14, 2)
  marginAmount      Decimal  @db.Decimal(14, 2)
  marginPercent     Decimal  @db.Decimal(8, 2)
  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())
  createdById       String
  createdBy         User     @relation("ProductPriceHistoryCreator", fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdById])
  @@index([effectiveFrom])
}

model YuanRateHistory {
  id            String   @id @default(cuid())
  rate          Decimal  @db.Decimal(14, 4)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  createdById   String
  createdBy     User     @relation("YuanRateHistoryCreator", fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
}

model StockMovement {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantity      Int
  unitCostKgs   Decimal           @default(0) @db.Decimal(14, 2)
  totalCostKgs  Decimal           @default(0) @db.Decimal(14, 2)
  note          String?
  referenceType String?
  referenceId   String?
  createdById   String
  createdBy     User              @relation("StockMovementCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([branchId])
  @@index([warehouseId])
  @@index([productId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model InventoryBalance {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Int       @default(0)
  averageCostKgs Decimal  @default(0) @db.Decimal(14, 2)
  totalValueKgs Decimal   @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime  @updatedAt

  @@unique([branchId, warehouseId, productId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([productId])
}

model KpiSnapshot {
  id                String   @id @default(cuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  snapshotDate      DateTime @default(now())
  totalSales        Decimal  @default(0) @db.Decimal(14, 2)
  totalProfit       Decimal  @default(0) @db.Decimal(14, 2)
  totalRepairs      Int      @default(0)
  averageRepairTime Decimal  @default(0) @db.Decimal(10, 2)
  inventoryValue    Decimal  @default(0) @db.Decimal(14, 2)
  lowStockCount     Int      @default(0)
  customerCount     Int      @default(0)
  newCustomers      Int      @default(0)
  repeatCustomers   Int      @default(0)
  debtAmount        Decimal  @default(0) @db.Decimal(14, 2)
  npsScore          Decimal  @default(0) @db.Decimal(5, 2)
