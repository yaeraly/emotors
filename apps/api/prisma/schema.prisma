  retailSilverMarkupPercent      Decimal           @default(3) @db.Decimal(8, 2)
  retailGoldMarkupPercent        Decimal           @default(1.5) @db.Decimal(8, 2)
  retailVipMarkupPercent         Decimal           @default(0) @db.Decimal(8, 2)
