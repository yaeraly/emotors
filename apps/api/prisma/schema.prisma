  masterSilverMarkupPercent      Decimal           @default(4) @db.Decimal(8, 2)
  masterGoldMarkupPercent        Decimal           @default(2) @db.Decimal(8, 2)
  masterVipMarkupPercent         Decimal           @default(1) @db.Decimal(8, 2)
  wholesaleStandardMarkupPercent Decimal           @default(5) @db.Decimal(8, 2)
  wholesaleSilverMarkupPercent   Decimal           @default(3) @db.Decimal(8, 2)
  wholesaleGoldMarkupPercent     Decimal           @default(1.5) @db.Decimal(8, 2)
